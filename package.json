    "typecheck": "tsc && tsc -p web",
    "test": "vitest run"
  },
  "dependencies": {
    "@git-diff-view/react": "0.1.8",
    "@hono/node-server": "2.1.8",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "dompurify": "3.4.17",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@octokit/graphql-schema": "15.26.1",
    "@octokit/types": "18.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "graphql": "17.1.0",
    "jsdom": "31.0.1",
    "msw": "3.0.5",
    "typescript": "7.0.2",
