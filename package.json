{
  "name": "pr-dashboard",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "node server/main.ts",
    "build": "vite build",
    "codegen": "graphql-codegen --config codegen.ts",
    "lint": "biome check .",
